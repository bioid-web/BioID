+    @sp.add_test()
+    def test_volume_rules():
+        # v0.4: conservation caps plain aliquots and splits by the burn. Steps that add
+        # liquid (isolation/elution, dilution, titration) may produce more volume.
+        scenario = sp.test_scenario("bioid_volume")
+        contract = bioid.Bioid(admin.address, metadata())
+        scenario += contract
+        tube = sp.View(contract, "tube")
+        register_core(contract, admin)
+        mint(contract, "SY00000501", 2000, intake.address, lab)
+        contract.move(code="SY00000501", to_wallet=aliq.address, reason="to_process", data=None, _sender=lab)
+
+        def tf(burn, added, reason, kids, valid=True, exc=None):
+            if valid:
+                contract.transform(code="SY00000501", burn_ul=burn, added_ul=added, reason=reason,
+                    reason_utf8=utf8(reason), children=kids, data=None, _sender=lab)
+            else:
+                contract.transform(code="SY00000501", burn_ul=burn, added_ul=added, reason=reason,
+                    reason_utf8=utf8(reason), children=kids, data=None, _sender=lab,
+                    _valid=False, _exception=exc)
+
+        # Capped split: 600 + 600 from a 1000 burn creates volume and is refused.
+        tf(1000, None, "aliquoted", [child("SY00000511", 600, "aliquot", aliq.address),
+            child("SY00000512", 600, "aliquot", aliq.address)], False, "BIOID_VOLUME")
+        tf(1000, None, "split", [child("SY00000511", 1001, "aliquot", aliq.address)], False, "BIOID_VOLUME")
+        # An aliquot that claims added liquid is a dilution in disguise.
+        tf(100, sp.Some(100), "aliquoted", [child("SY00000511", 150, "aliquot", aliq.address)], False, "BIOID_VOLUME")
+        # Split with dead-volume loss is fine.
+        tf(1000, None, "split", [child("SY00000511", 490, "aliquot", aliq.address),
+            child("SY00000512", 490, "aliquot", aliq.address)])
+        scenario.verify(tube("SY00000501").balance == 1000)
+        # Extraction: 50 uL consumed, eluted in 100 uL, no added volume recorded: allowed.
+        tf(50, None, "dna_isolation", [child("SY00000521", 100, "dna", aliq.address)])
+        # Extraction with recorded elution: output capped by burn + added.
+        tf(50, sp.Some(100), "dna_isolation", [child("SY00000522", 150, "dna", aliq.address)])
+        tf(50, sp.Some(100), "dna_isolation", [child("SY00000523", 151, "dna", aliq.address)], False, "BIOID_VOLUME")
+        # Dilution 1:10: 100 uL plus 900 uL diluent gives 1000 uL, more than the burn.
+        tf(100, None, "dilution", [child("SY00000531", 1000, "diluted", aliq.address)], False, "BIOID_VOLUME")
+        tf(100, sp.Some(900), "dilution", [child("SY00000531", 1000, "diluted", aliq.address)])
+        scenario.verify(tube("SY00000531").balance == 1000)
+        tf(100, sp.Some(900), "titration", [child("SY00000532", 500, "diluted", aliq.address),
+            child("SY00000533", 501, "diluted", aliq.address)], False, "BIOID_VOLUME")
+        # Source material consumed is still conserved: the burn cannot exceed the balance.
+        scenario.verify(tube("SY00000501").balance == 800)
+        tf(801, sp.Some(10000), "dilution", [child("SY00000534", 1000, "diluted", aliq.address)], False, "BIOID_BURN")
+        # adjust_volume: only "measured" may raise a volume.
+        contract.move(code="SY00000521", to_wallet=freezer.address, reason="stored", data=None, _sender=lab)
+        contract.adjust_volume(code="SY00000521", volume_ul=120, reason="evaporation", _sender=lab,
+            _valid=False, _exception="BIOID_ADJUST")
+        contract.adjust_volume(code="SY00000521", volume_ul=95, reason="evaporation", _sender=lab)
+        contract.adjust_volume(code="SY00000521", volume_ul=97, reason="measured", _sender=lab)
+        scenario.verify(tube("SY00000521").balance == 97)
+        # confirm_destroyed: the owner orders, only the custodian attests.
+        contract.withdraw(code="SY00000501", outcome="destroy", _sender=owner)
+        contract.confirm_destroyed("SY00000521", _sender=owner, _valid=False, _exception="BIOID_NOT_CUSTODIAN")
+        contract.confirm_destroyed("SY00000521", _sender=lab)
+        # unfreeze_anonymised runs once.
+        mint(contract, "SY00000601", 100, intake.address, lab)
+        contract.withdraw(code="SY00000601", outcome="anonymise", _sender=owner)
+        contract.unfreeze_anonymised("SY00000601", _sender=owner)
+        contract.unfreeze_anonymised("SY00000601", _sender=owner, _valid=False, _exception="BIOID_FROZEN")
