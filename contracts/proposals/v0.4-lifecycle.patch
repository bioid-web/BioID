+        contract.withdraw(code="SY00000701", outcome="anonymise", _sender=owner,
+            _valid=False, _exception="BIOID_FROZEN")
+        contract.confirm_destroyed("SY00000713", _sender=lab)
+        scenario.verify(tube("SY00000713").status == "destroyed")
+        scenario.verify(tube("SY00000713").balance == 0)
