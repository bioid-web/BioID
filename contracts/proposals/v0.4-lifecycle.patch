+    @sp.add_test()
+    def test_lifecycle():
+        # v0.4 lifecycle proposal: constant-cost withdrawal, stop_use escalation,
+        # owner rotation, explicit lineage depth.
+        scenario = sp.test_scenario("bioid_lifecycle")
+        contract = bioid.Bioid(admin.address, metadata())
+        scenario += contract
+        tube = sp.View(contract, "tube")
+        register_core(contract, admin)
+
+        # A root with a wide, deep lineage. Withdrawal writes once on the root.
+        mint(contract, "SY00000701", 5000, intake.address, lab)
+        contract.attach_data(code="SY00000701", data=data_of(
+            "https://example.org/synthetic/lifecycle/SY00000701", "intake", "metadata"), _sender=lab)
+        contract.move(code="SY00000701", to_wallet=aliq.address, reason="to_process", data=None, _sender=lab)
+        contract.transform(code="SY00000701", burn_ul=1000, added_ul=None, reason="aliquoted",
+            reason_utf8=utf8("aliquoted"), children=[
+                child("SY00000711", 200, "aliquot", aliq.address),
+                child("SY00000712", 200, "aliquot", aliq.address),
+                child("SY00000713", 200, "aliquot", freezer.address),
+                child("SY00000714", 200, "aliquot", freezer.address),
+                child("SY00000715", 200, "aliquot", freezer.address),
+            ], data=None, _sender=lab)
+        # Depth: generations 1..7 are allowed, an eighth derived generation is refused.
+        parent = "SY00000711"
+        volume = 200
+        for gen in range(2, 8):
+            code = "SY0000072" + str(gen)
+            volume = volume - 10
+            contract.transform(code=parent, burn_ul=volume + 5, added_ul=None, reason="aliquoted",
+                reason_utf8=utf8("aliquoted"), children=[child(code, volume, "aliquot", aliq.address)],
+                data=None, _sender=lab)
+            parent = code
+        scenario.verify(tube("SY00000727").depth == 7)
+        contract.transform(code="SY00000727", burn_ul=10, added_ul=None, reason="aliquoted",
+            reason_utf8=utf8("aliquoted"), children=[child("SY00000728", 10, "aliquot", aliq.address)],
+            data=None, _sender=lab, _valid=False, _exception="BIOID_DEPTH")
+        # The deepest allowed tube still sees the root dataset: the view is complete.
+        scenario.verify(sp.View(contract, "lineage_has")(sp.record(code="SY00000727",
+            uri="https://example.org/synthetic/lifecycle/SY00000701")))
+
+        # The withdrawal owner of a root is fixed at mint. In production it is an
+        # institutional multisig (for example TzSafe 2-of-3), so key rotation happens
+        # inside the multisig and needs no entrypoint here.
+        mint(contract, "SY00000801", 100, intake.address, lab)
+        scenario.verify(tube("SY00000715").owner == owner.address)
+        contract.withdraw(code="SY00000701", outcome="stop_use", _sender=lab,
+            _valid=False, _exception="BIOID_NOT_OWNER")
+
+        # stop_use freezes every descendant through the root, at constant cost.
+        contract.withdraw(code="SY00000701", outcome="stop_use", _sender=owner)
+        scenario.verify(tube("SY00000727").status == "stopped")
+        scenario.verify(tube("SY00000715").status == "stopped")
+        contract.move(code="SY00000715", to_wallet=other_freezer.address, reason="moved", data=None,
+            _sender=lab, _valid=False, _exception="BIOID_FROZEN")
+        contract.consume(code="SY00000712", amount=1, data=None, _sender=lab,
+            _valid=False, _exception="BIOID_FROZEN")
+        # Data can still be attached to a stopped tube (audit trail stays open).
+        contract.attach_data(code="SY00000713", data=data_of(
+            "https://example.org/synthetic/lifecycle/SY00000713", "storage", "qc"), _sender=lab)
+        # Escalation: stop_use -> destroy is allowed; repeating or relaxing is not.
+        contract.withdraw(code="SY00000701", outcome="stop_use", _sender=owner,
+            _valid=False, _exception="BIOID_FROZEN")
+        contract.confirm_destroyed("SY00000713", _sender=lab, _valid=False, _exception="BIOID_BAD_REASON")
+        contract.withdraw(code="SY00000701", outcome="destroy", _sender=owner)
