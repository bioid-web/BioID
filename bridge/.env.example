# Shadownet settings for TezosBackend. Ghostnet has been removed.
# TEZOS_CONTRACT is the KT1 from contracts/deploy/originate.sh. Leave it empty
# until that origination has been run by an operator.
# TEZOS_KEY_REF is an HSM or cloud KMS alias. Never put an edsk or other secret here.
TEZOS_NETWORK=shadownet
TEZOS_RPC_URL=https://rpc.shadownet.teztnets.com
TEZOS_CONTRACT=
TEZOS_KEY_REF=kms://alias/syn-custodian-lab
